// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int             @id @default(autoincrement())
  email                String          @unique
  name                 String
  password             String
  PhoneNumber          String
  AccountBalance       AccountBalance?
  sentTransactions     Transaction[]   @relation("SentTransactions")
  receivedTransactions Transaction[]   @relation("ReceivedTransactions")
}

model AccountBalance {
  id     Int  @id @default(autoincrement())
  amount Int
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Int
  createdAt DateTime @default(now()) // Automatically saves the exact time!

  // Who sent it?
  fromUserId Int
  fromUser   User @relation("SentTransactions", fields: [fromUserId], references: [id])

  // Who received it?
  toUserId Int
  toUser   User @relation("ReceivedTransactions", fields: [toUserId], references: [id])
}
